# Azure OpenAI (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure AD (for email trigger + meeting scheduling)
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REFRESH_TOKEN=your-refresh-token

# Performance Manager
PERF_MANAGER_EMAIL=your-email@company.com

# Jira MCP (optional - for Bedrock Agent Gateway)
BEDROCK_GATEWAY_ID=your-gateway-id
AWS_REGION=us-east-1
ENTRA_USER_OID=your-entra-object-id
